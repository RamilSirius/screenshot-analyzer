# Скопируй в .env и впиши свой ключ Claude (console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# --- необязательные настройки сервера ---
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=medium
# MAX_CONCURRENCY=12
# SAVE_SCREENSHOTS=1
